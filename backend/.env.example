PORT=4000

# If using Supabase: DATABASE_URL should be the "Transaction pooler" connection string
# (port 6543, includes ?pgbouncer=true) and DIRECT_URL should be the "Session pooler" or
# direct connection string (port 5432). Copy both directly from Project Settings > Database >
# Connection string in the Supabase dashboard — don't hand-type them.
# If using a plain local/self-hosted Postgres, DATABASE_URL and DIRECT_URL can be the same value.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hr_system?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hr_system?schema=public"

JWT_SECRET="change_this_to_a_long_random_string"
JWT_EXPIRES_IN="1d"
CLIENT_URL="http://localhost:5173"

# Optional: per-seat billing via Stripe. Everything works without these set —
# companies just won't have live billing until you add real keys.
# Get these from https://dashboard.stripe.com/apikeys (use test keys first).
STRIPE_SECRET_KEY=""
# From the webhook endpoint you create at https://dashboard.stripe.com/webhooks
# pointing to https://your-backend-url/api/billing/webhook
STRIPE_WEBHOOK_SECRET=""
