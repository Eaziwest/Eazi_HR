generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                   String         @id @default(uuid())
  name                 String
  slug                 String         @unique
  contactName          String?
  contactEmail         String
  billingStatus        BillingStatus  @default(TRIALING)
  pricePerSeatCents    Int            @default(500)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  trialEndsAt          DateTime?
  suspendedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  announcements        Announcement[]
  departments          Department[]
  users                User[]
}

model Department {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  employees User[]

  @@unique([companyId, name])
}

model User {
  id                  String             @id @default(uuid())
  employeeCode        String?
  firstName           String
  lastName            String
  email               String             @unique
  passwordHash        String
  role                Role               @default(EMPLOYEE)
  position            String?
  status              EmployeeStatus     @default(ONBOARDING)
  dateHired           DateTime           @default(now())
  phone               String?
  departmentId        String?
  managerId           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  companyId           String?
  mustChangePassword  Boolean            @default(false)
  announcementsPosted Announcement[]     @relation("AnnouncementsAuthored")
  appraisalsReceived  Appraisal[]        @relation("EmployeeAppraisals")
  appraisalsGiven     Appraisal[]        @relation("ReviewerAppraisals")
  attendanceEntries   AttendanceEntry[]  @relation("EmployeeAttendance")
  leaveBalances       LeaveBalance[]
  approvedLeaves      LeaveRequest[]     @relation("ApproverLeaves")
  leaveRequests       LeaveRequest[]     @relation("EmployeeLeaves")
  onboardingTasks     OnboardingTask[]
  approvedSickLeaves  SickLeaveRequest[] @relation("ApproverSickLeaves")
  sickLeaves          SickLeaveRequest[] @relation("EmployeeSickLeaves")
  company             Company?           @relation(fields: [companyId], references: [id])
  department          Department?        @relation(fields: [departmentId], references: [id])
  manager             User?              @relation("ManagerReports", fields: [managerId], references: [id])
  reports             User[]             @relation("ManagerReports")

  @@unique([companyId, employeeCode])
}

model OnboardingTask {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
}

model LeaveRequest {
  id              String      @id @default(uuid())
  userId          String
  type            LeaveType
  startDate       DateTime
  endDate         DateTime
  daysRequested   Float
  reason          String?
  status          LeaveStatus @default(PENDING)
  approverId      String?
  approverComment String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  approver        User?       @relation("ApproverLeaves", fields: [approverId], references: [id])
  user            User        @relation("EmployeeLeaves", fields: [userId], references: [id])
}

model SickLeaveRequest {
  id                    String      @id @default(uuid())
  userId                String
  startDate             DateTime
  endDate               DateTime
  daysRequested         Float
  reason                String?
  medicalCertificateUrl String?
  status                LeaveStatus @default(PENDING)
  approverId            String?
  approverComment       String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  approver              User?       @relation("ApproverSickLeaves", fields: [approverId], references: [id])
  user                  User        @relation("EmployeeSickLeaves", fields: [userId], references: [id])
}

model LeaveBalance {
  id                String @id @default(uuid())
  userId            String
  year              Int
  annualEntitlement Float  @default(20)
  annualUsed        Float  @default(0)
  sickEntitlement   Float  @default(10)
  sickUsed          Float  @default(0)
  user              User   @relation(fields: [userId], references: [id])

  @@unique([userId, year])
}

model Appraisal {
  id                  String          @id @default(uuid())
  employeeId          String
  reviewerId          String
  period              String
  goals               String?
  achievements        String?
  strengths           String?
  areasForImprovement String?
  rating              Int?
  employeeComment     String?
  status              AppraisalStatus @default(DRAFT)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  employee            User            @relation("EmployeeAppraisals", fields: [employeeId], references: [id])
  reviewer            User            @relation("ReviewerAppraisals", fields: [reviewerId], references: [id])
}

model AttendanceEntry {
  id        String    @id @default(uuid())
  userId    String
  clockIn   DateTime  @default(now())
  clockOut  DateTime?
  note      String?
  createdAt DateTime  @default(now())
  user      User      @relation("EmployeeAttendance", fields: [userId], references: [id])
}

model Announcement {
  id        String   @id @default(uuid())
  companyId String
  authorId  String
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  author    User     @relation("AnnouncementsAuthored", fields: [authorId], references: [id])
  company   Company  @relation(fields: [companyId], references: [id])
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
  SUPER_ADMIN
}

enum BillingStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum EmployeeStatus {
  ONBOARDING
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum LeaveType {
  ANNUAL
  CASUAL
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AppraisalStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  ACKNOWLEDGED
}
